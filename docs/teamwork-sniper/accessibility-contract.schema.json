{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyclone.local/teamwork-sniper/accessibility-contract.schema.json",
  "title": "Teamwork Sniper Accessibility Contract",
  "type": "object",
  "required": ["schemaVersion", "evidenceLevel", "shifts"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "evidenceLevel": {"enum": ["LIVE_CONFIRMED", "PROVISIONAL", "SYNTHETIC_ONLY"]},
    "shifts": {"type": "array", "items": {"$ref": "#/$defs/OpenShift"}}
  },
  "$defs": {
    "OpenShift": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "day", "code", "start", "end", "state", "semanticRowIdentity", "claimCandidatePath", "confidence", "ambiguity", "evidenceLevel"],
      "properties": {
        "date": {"type": ["string", "null"], "format": "date"},
        "day": {"type": ["string", "null"], "enum": ["MON", "TUE", "WED", "THU", "FRI", "SAT", "SUN", null]},
        "code": {"type": ["string", "null"], "pattern": "^[MS][0-9]+$"},
        "start": {"type": ["string", "null"], "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"},
        "end": {"type": ["string", "null"], "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"},
        "state": {"enum": ["OPEN_TO_TAKE"]},
        "semanticRowIdentity": {"type": "string", "minLength": 8},
        "claimCandidatePath": {"type": ["string", "null"]},
        "confidence": {"enum": ["UNAMBIGUOUS", "AMBIGUOUS"]},
        "ambiguity": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "evidenceLevel": {"enum": ["LIVE_CONFIRMED", "PROVISIONAL", "SYNTHETIC_ONLY"]}
      }
    }
  }
}
