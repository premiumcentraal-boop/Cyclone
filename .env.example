# Cyclone local development configuration.
# Copy to .env. Never commit real values.

CYCLONE_VAULT_HOST_PATH=C:/Users/Agent/Documents/CycloneVault
CYCLONE_WORKSPACE_HOST_PATH=C:/Users/Agent/Documents/CycloneWorkspace

POSTGRES_DB=cyclone
POSTGRES_USER=cyclone
POSTGRES_PASSWORD=change-me-postgres-password
N8N_POSTGRES_DB=n8n
N8N_POSTGRES_USER=cyclone
N8N_POSTGRES_PASSWORD=change-me-n8n-password
N8N_ENCRYPTION_KEY=change-me-n8n-encryption-key-at-least-32-characters
N8N_USER_MANAGEMENT_JWT_SECRET=change-me-n8n-jwt-secret-at-least-32-characters

HERMES_API_KEY=change-me-hermes-api-key-at-least-32-characters
CYCLONE_INTERNAL_API_KEY=change-me-internal-event-key-at-least-32-characters
CYCLONE_HOST_BRIDGE_TOKEN=change-me-host-bridge-token-at-least-32-characters
# This is the Bearer credential used by Cyclone Mobile V2 at /api/v1/mobile/connect.
CYCLONE_MOBILE_DEVICE_TOKEN=change-me-mobile-device-token-at-least-32-characters

CYCLONE_CORE_INTERNAL_URL=http://cyclone-core:8787
GENERIC_TIMEZONE=Europe/Amsterdam
TZ=Europe/Amsterdam

# Optional enhanced Android backend. Mobilerun Portal remains a separately installed
# AGPL companion and is never bundled silently into Cyclone.
# CYCLONE_MOBILERUN_PORTAL_URL=http://192.168.1.42:8080
# CYCLONE_MOBILERUN_PORTAL_TOKEN=

# Optional model credentials (keep only in local untracked .env).
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=

# Optional Telegram remote channel.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_USERS=
# TELEGRAM_HOME_CHANNEL=
