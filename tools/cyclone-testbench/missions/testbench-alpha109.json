[
  {
    "id": "tb.read.timeout.value",
    "title": "Read the screen timeout",
    "goal": "What is my screen timeout set to?",
    "category": "read",
    "suites": [
      "alpha109",
      "settings",
      "read"
    ],
    "apps": [
      "com.android.settings"
    ],
    "setup": [
      {
        "do": "setting",
        "namespace": "system",
        "key": "screen_off_timeout",
        "value": "120000"
      },
      {
        "do": "force_stop",
        "package": "com.android.settings"
      },
      {
        "do": "home"
      }
    ],
    "checks": [
      {
        "check": "answer",
        "regex": "(?i)\\b(2|two)\\s*min"
      }
    ],
    "notes": "Alpha 109: a read-only walk to the Screen timeout page, where reads were thrown away."
  },
