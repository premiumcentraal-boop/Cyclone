 {
  "id": "tb.robust.two.settings",
  "title": "Two settings in one sentence",
  "goal": "turn on dark mode and set the screen timeout to 2 minutes",
  "category": "robustness",
  "suites": [
   "robust"
  ],
  "apps": [
   "com.android.settings"
  ],
  "setup": [
   {
    "do": "night_mode",
    "on": false
   },
   {
    "do": "setting",
    "namespace": "system",
    "key": "screen_off_timeout",
    "value": "30000"
   },
   {
    "do": "home"
   }
  ],
  "checks": [
   {
    "check": "night_mode",
    "is": true
   },
   {
    "check": "setting",
    "namespace": "system",
    "key": "screen_off_timeout",
    "equals": "120000"
   }
  ]
 }
]
