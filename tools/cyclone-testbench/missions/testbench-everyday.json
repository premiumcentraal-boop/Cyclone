[
 {
  "id": "tb.every.stopwatch",
  "title": "Time something",
  "goal": "time how long this takes, start a stopwatch",
  "category": "everyday",
  "suites": [
   "everyday"
  ],
  "apps": [
   "com.google.android.deskclock"
  ],
  "setup": [
   {
    "do": "force_stop",
    "package": "com.google.android.deskclock"
   },
   {
    "do": "home"
   }
  ],
  "checks": [
   {
    "check": "foreground",
    "package": "com.google.android.deskclock"
   },
   {
    "check": "screen",
    "any": [
     "Lap",
     "Pause",
     "Ronde",
     "Onderbreken",
     "Pauzeren"
    ]
   }
  ]
 },
 {
  "id": "tb.every.drive.time",
  "title": "Driving time",
  "goal": "How long does it take to drive from Utrecht to Amsterdam right now?",
  "category": "everyday",
  "suites": [
   "everyday"
  ],
  "apps": [
   "com.google.android.apps.maps"
  ],
  "setup": [
   {
    "do": "force_stop",
    "package": "com.google.android.apps.maps"
   },
   {
    "do": "home"
   }
  ],
  "checks": [
   {
    "check": "status",
    "is": [
     "completed"
    ]
   },
   {
    "check": "answer",
    "regex": "(?i)\\b\\d{1,3}\\s*(min|mins|minutes|minuten)\\b"
   }
  ]
 },
