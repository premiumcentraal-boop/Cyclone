 {
  "id": "tb.every.weather",
  "title": "Tomorrow's weather",
  "goal": "What's the weather going to be in Amsterdam tomorrow?",
  "category": "everyday",
  "suites": [
   "everyday",
   "tb-smoke"
  ],
  "setup": [
   {
    "do": "home"
   }
  ],
  "checks": [
   {
    "check": "status",
    "is": [
     "completed"
    ]
   },
   {
    "check": "answer",
    "regex": "-?\\d{1,2}\\s*°"
   }
  ]
 },
 {
  "id": "tb.every.currency",
  "title": "Currency",
  "goal": "How many euros is 100 US dollars today?",
  "category": "everyday",
  "suites": [
   "everyday"
  ],
  "setup": [
   {
    "do": "home"
   }
  ],
  "checks": [
   {
    "check": "status",
    "is": [
     "completed"
    ]
   },
   {
    "check": "answer",
    "regex": "\\b(7[5-9]|8\\d|9\\d|10[0-5])([.,]\\d+)?\\b"
   }
  ]
 },
 {
  "id": "tb.every.split.bill",
