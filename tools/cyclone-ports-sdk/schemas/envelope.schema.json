{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyclone.local/schemas/cyclone.ports/1/envelope.json",
  "title": "Out-port envelope (hub -> plugin, POST /ports/{port})",
  "type": "object",
  "required": ["v", "runId", "port", "way", "seq", "sentAt", "sensitivity", "data"],
  "properties": {
    "v": {"const": 1},
    "runId": {"type": "string"},
    "taskId": {"type": ["string", "null"]},
    "rowId": {"type": ["string", "null"]},
    "port": {"enum": ["run.event", "screen.shot", "account.fields", "page.text", "file.out", "log.line"]},
    "way": {"const": "out"},
    "seq": {"type": "integer", "minimum": 1, "description": "Increases per run; use it to order and de-duplicate."},
    "sentAt": {"type": "string", "format": "date-time"},
    "app": {"type": ["string", "null"], "description": "Android package of the app the run is in."},
    "pageKey": {"type": ["string", "null"], "description": "Stable page id from the Sign-up Map or the page fingerprint."},
    "sensitivity": {"enum": ["public", "personal"]},
    "data": {"type": "object"},
    "artifactUrl": {"type": "string", "description": "screen.shot and file.out only: a one-time link, valid 120 s."}
  }
}
