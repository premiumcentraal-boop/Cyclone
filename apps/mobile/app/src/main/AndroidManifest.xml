<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Cyclone is a task-automation app. Android documents that as an acceptable direct Doze
         exemption use case, but the user still grants or declines it in a system-owned dialog. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:label="Cyclone"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode_ui" />

        <provider
            android:name=".gateway.GatewayInitProvider"
            android:authorities="${applicationId}.gateway-init"
            android:exported="false"
            android:initOrder="100" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="cyclone" android:host="pair" />
            </intent-filter>
        </activity>

        <activity
            android:name=".gateway.GatewaySettingsActivity"
            android:exported="false"
            android:label="Cyclone PC Gateway" />

        <activity
            android:name=".guided.RoutineTeachingHistoryActivity"
            android:exported="false" />

        <activity
            android:name=".ai.TaskResultActivityV292"
            android:exported="false" />

        <activity
            android:name=".debug.PageDebugSandboxActivityV293"
            android:exported="false" />

        <receiver
            android:name=".automation.AutomationAlarmReceiver"
            android:exported="false" />

        <!-- The embedded Mobilerun module remains available as compatibility code, but Cyclone
             owns the user-facing permission endpoints. Removing these merged services prevents
             Android from presenting a second "Cyclone Enhanced" accessibility/notification grant. -->
        <service
            android:name="com.mobilerun.portal.service.MobilerunAccessibilityService"
            tools:node="remove" />
        <service
            android:name="com.mobilerun.portal.service.MobilerunNotificationListener"
            tools:node="remove" />

        <!-- AccessibilityManager is a system process and must be able to bind this service.
             BIND_ACCESSIBILITY_SERVICE keeps the exported endpoint system-only. -->
        <service
            android:name=".CycloneAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <service
            android:name=".CycloneNotificationListener"
            android:exported="true"
            android:label="Cyclone notification listener"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
